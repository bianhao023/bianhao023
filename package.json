{
  "name": "vpn-payment-backend",
  "version": "1.0.0",
  "description": "Commercial-grade payment backend for a VPN service. Supports WeChat Pay, Alipay and USDT (TRC20). Zero runtime dependencies.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:only": "node --test dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "sandbox:usdt": "node dist/scripts/sandbox-usdt.js",
    "sandbox:alipay": "node dist/scripts/sandbox-alipay.js",
    "sandbox:wechat": "node dist/scripts/sandbox-wechat.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
