# ── Persistence (PRODUCTION) ────────────────────────────────────────────────
# PostgreSQL connection string. When set, ALL state (orders, users, refunds,
# subscriptions, audit) is stored in Postgres and the schema is applied
# automatically on boot. LEAVE EMPTY only for local/dev — in-memory storage
# loses everything on restart and must NOT be used in production.
DATABASE_URL=
# Redis connection string (optional). When set, rate limiting is Redis-backed so
# it is correct across multiple app instances. Recommended when running >1 replica.
REDIS_URL=

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
# Minutes a pending order stays payable before it is auto-expired.
ORDER_TTL_MINUTES=15
# Max ms to wait for in-flight requests to drain on shutdown before forcing.
SHUTDOWN_TIMEOUT_MS=10000
# debug | info | warn | error | silent
LOG_LEVEL=info
# Bearer token guarding the /admin endpoints. Leave empty to disable admin.
ADMIN_TOKEN=
# Previous admin token, still accepted during rotation (set briefly, then clear).
ADMIN_TOKEN_PREVIOUS=
# Days before a subscription expires to send a renewal reminder.
EXPIRY_REMINDER_DAYS=3
# Days to retain processed-event dedupe records before cleanup.
PROCESSED_EVENT_TTL_DAYS=7

# ── Rate limiting (per client IP + route, fixed window) ─────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60

# ── HTTP security hardening ─────────────────────────────────────────────────
# Comma-separated allowed CORS origins; "*" allows any; empty disables CORS.
CORS_ORIGINS=
REQUEST_TIMEOUT_MS=15000
MAX_BODY_BYTES=1000000
SECURITY_HEADERS=true

# ── Live exchange-rate feed (optional; falls back to a static table) ─────────
# URL returning rates relative to FX_BASE; "{base}" is interpolated if present.
FX_RATES_URL=
FX_BASE=CNY
FX_TTL_SEC=3600

# ── SMTP (outbound billing emails; optional) ────────────────────────────────
# Set SMTP_HOST to enable the SMTP mail sender.
SMTP_HOST=
SMTP_PORT=587
# true => connect over TLS directly (e.g. port 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# ── Outbound merchant webhooks (optional) ───────────────────────────────────
# Set WEBHOOK_URL to publish signed order.fulfilled / refund.updated events.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Delivery attempts before a delivery is dead-lettered.
WEBHOOK_MAX_ATTEMPTS=6

# ── WeChat Pay v3 (Native / scan-to-pay) ────────────────────────────────────
# A method is only enabled when its mandatory variables are present.
WECHAT_APP_ID=
WECHAT_MCH_ID=
# Merchant API private key (PEM). Use literal \n for newlines if single-line.
WECHAT_PRIVATE_KEY=
WECHAT_SERIAL_NO=
# APIv3 key (exactly 32 characters) used to decrypt notifications.
WECHAT_API_V3_KEY=
# WeChat platform public certificate (PEM) used to verify notifications.
WECHAT_PLATFORM_PUBLIC_KEY=
# Incoming platform cert (PEM) also accepted during WeChat cert rotation.
WECHAT_PLATFORM_PUBLIC_KEY_NEXT=
WECHAT_NOTIFY_URL=https://your-domain.com/api/notify/wechat
WECHAT_API_BASE=https://api.mch.weixin.qq.com

# ── Alipay (trade.precreate / merchant-presented QR) ────────────────────────
ALIPAY_APP_ID=
# Merchant app private key (PEM, PKCS8).
ALIPAY_PRIVATE_KEY=
# Alipay public key (PEM) used to verify async notifications.
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/notify/alipay
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ── USDT (TRC20 on TRON) ────────────────────────────────────────────────────
# Shared receiving address; orders are matched by a unique exact amount.
USDT_RECEIVING_ADDRESS=
# Defaults to the canonical USDT-TRC20 contract if omitted.
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_API_BASE=https://api.trongrid.io
USDT_API_KEY=
# Confirmations before a transfer is treated as settled.
USDT_MIN_CONFIRMATIONS=19
# Max micro-USDT delta added per order for uniqueness (9999 = up to 0.009999).
USDT_UNIQUE_DELTA_MAX=9999
