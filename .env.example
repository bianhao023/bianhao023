# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
# Minutes a pending order stays payable before it is auto-expired.
ORDER_TTL_MINUTES=15
# debug | info | warn | error | silent
LOG_LEVEL=info

# ── WeChat Pay v3 (Native / scan-to-pay) ────────────────────────────────────
# A method is only enabled when its mandatory variables are present.
WECHAT_APP_ID=
WECHAT_MCH_ID=
# Merchant API private key (PEM). Use literal \n for newlines if single-line.
WECHAT_PRIVATE_KEY=
WECHAT_SERIAL_NO=
# APIv3 key (exactly 32 characters) used to decrypt notifications.
WECHAT_API_V3_KEY=
# WeChat platform public certificate (PEM) used to verify notifications.
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_NOTIFY_URL=https://your-domain.com/api/notify/wechat
WECHAT_API_BASE=https://api.mch.weixin.qq.com

# ── Alipay (trade.precreate / merchant-presented QR) ────────────────────────
ALIPAY_APP_ID=
# Merchant app private key (PEM, PKCS8).
ALIPAY_PRIVATE_KEY=
# Alipay public key (PEM) used to verify async notifications.
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/api/notify/alipay
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ── USDT (TRC20 on TRON) ────────────────────────────────────────────────────
# Shared receiving address; orders are matched by a unique exact amount.
USDT_RECEIVING_ADDRESS=
# Defaults to the canonical USDT-TRC20 contract if omitted.
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_API_BASE=https://api.trongrid.io
USDT_API_KEY=
# Confirmations before a transfer is treated as settled.
USDT_MIN_CONFIRMATIONS=19
# Max micro-USDT delta added per order for uniqueness (9999 = up to 0.009999).
USDT_UNIQUE_DELTA_MAX=9999
